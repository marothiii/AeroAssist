  "confidence_policy": {
    "confident": {
      "min": 0.8,
      "action": "Return normal recommendation."
    },
    "caution": {
      "min": 0.6,
      "max": 0.799999,
      "action": "Return recommendation with uncertainty warning and verification advice."
    },
    "uncertain": {
      "max": 0.599999,
      "action": "Do not guess; request clarification, clearer input, or human assistance."
    }
  },
  "conflict_policy": {
    "description": "Flag semantically incompatible high-confidence evidence from different modalities instead of blindly averaging it.",
    "example": "Image=baggage_claim while text intent=find_gate -> multimodal conflict warning."
  }
